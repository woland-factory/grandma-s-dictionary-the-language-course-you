# Runtime configuration for the staging container. Copy to .env and fill in.
# All values are optional. Leave a value empty to turn that channel off.

# Load the bundled demo dictionary on first open (set to 1 on staging).
SEED_DEMO=

# Umami analytics. Both are needed for analytics to load.
UMAMI_URL=
UMAMI_WEBSITE_ID=

# Error tracking (GlitchTip / Sentry) DSN.
SENTRY_DSN=
